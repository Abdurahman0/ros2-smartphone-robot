# --- colcon build artefacts (regenerated by `colcon build`, never committed) ---
build/
install/
log/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- ROS 2 recordings: rosbags are large binary files, keep them out of git ---
*.db3
*.mcap
rosbag2_*/

# --- Gazebo / rendering caches ---
.gazebo/
.ignition/
.gz/

# --- editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store

# --- large media: demo video is linked from the README, not stored in the repo ---
demo/*.mp4
demo/*.mkv

# --- crash dumps left by killed simulator processes ---
core
core.*

# --- tf2_tools view_frames output (regenerate on demand) ---
frames_*.gv
frames_*.pdf

# --- the map lives inside the package (so colcon installs it), not at the repo root ---
/maps/
