# --- colcon build artefacts (regenerated by `colcon build`, never committed) ---
build/
install/
log/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- ROS 2 recordings: rosbags are large binary files, keep them out of git ---
*.db3
*.mcap
rosbag2_*/

# --- Gazebo / rendering caches ---
.gazebo/
.ignition/
.gz/

# --- editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store

# --- large media ---
# The short navigation demo (~1.6 MB) is small enough to keep in the repo; anything
# longer or raw should be linked instead of committed.
demo/*.mkv
demo/*.raw
demo/_*

# --- crash dumps left by killed simulator processes ---
core
core.*

# --- tf2_tools view_frames output (regenerate on demand) ---
frames_*.gv
frames_*.pdf

# --- the map lives inside the package (so colcon installs it), not at the repo root ---
/maps/

# --- YOLO model weights (24 MB, downloaded by scripts/download_yolo.sh) ---
models/yolo/*.weights
