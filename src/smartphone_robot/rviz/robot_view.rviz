Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /RobotModel1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 160; 160; 164
      Line Style:
        Value: Lines
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      # RViz does not read the .urdf file. robot_state_publisher publishes the
      # expanded URDF as a string on this topic, and RViz renders whatever it finds
      # there. That is why RViz shows nothing if robot_state_publisher is not running.
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Marker Scale: 0.3
      Update Interval: 0
  Global Options:
    # Everything drawn in RViz is transformed into this frame. base_footprint is on
    # the ground under the robot, so the robot appears to sit on the grid.
    Fixed Frame: base_footprint
    Background Color: 48; 48; 48
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 1.6
      Focal Point:
        X: 0
        Y: 0
        Z: 0.05
      Pitch: 0.45
      Yaw: 0.8
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 800
  Width: 1200
  Displays:
    collapsed: false
