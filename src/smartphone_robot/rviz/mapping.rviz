Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: [/Map1, /LaserScan1]
    Tree Height: 500
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 100; 100; 100
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.9
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Size (m): 0.02
      Style: Spheres
      Color: 255; 40; 40
      Color Transformer: FlatColor
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.4
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: false
      Topic:
        Value: /odom
      Keep: 100
      Shape:
        Shaft Length: 0.2
        Head Length: 0.1
  Global Options:
    Fixed Frame: map
    Background Color: 40; 42; 48
    Frame Rate: 15
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 14
      # The map frame is anchored where SLAM started, i.e. the robot's spawn pose, so
      # the room extends from about (0,0) to (7,7) in map coordinates. Centring the view
      # on (3,3) keeps the whole room in frame as it is discovered.
      Focal Point: {X: 3.0, Y: 3.0, Z: 0}
      # Pitch is near vertical on purpose. The map is drawn at z=0 but the laser returns
      # are at the LiDAR's height (z=0.17 m), so with a tilted camera the returns are
      # projected outward and appear NOT to line up with the walls -- worst at the edges
      # of the view, fine near the centre. That is parallax, not a localisation error,
      # but it looks exactly like one. A top-down view removes the ambiguity.
      Pitch: 1.5500
      Yaw: 3.14
      Target Frame: <Fixed Frame>
# Window Geometry below was written by RViz itself, not by hand. 'QMainWindow State'
# is a Qt-serialised blob describing dock sizes and positions; without it RViz falls
# back to distributing panels evenly, which is why a config can look completely
# different on another screen size. Regenerate with scripts/bake_rviz_geometry.sh.
Window Geometry:
  Displays:
    collapsed: false
  Height: 1040
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 000000ff00000000fd000000010000000000000156000003b5fc0200000001fb000000100044006900730070006c006100790073010000003e000003b5000000cb00ffffff00000624000003b500000004000000040000000800000008fc0000000100000002000000010000000a0054006f006f006c00730100000000ffffffff0000000000000000
  Width: 1920
  X: -1
  Y: -20
