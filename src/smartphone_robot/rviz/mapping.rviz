Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: [/Map1, /LaserScan1]
    Tree Height: 500
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 100; 100; 100
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.9
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Size (m): 0.035
      Style: Spheres
      Color: 255; 40; 40
      Color Transformer: FlatColor
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.4
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: false
      Topic:
        Value: /odom
      Keep: 100
      Shape:
        Shaft Length: 0.2
        Head Length: 0.1
  Global Options:
    Fixed Frame: map
    Background Color: 40; 42; 48
    Frame Rate: 15
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 14
      # The map frame is anchored where SLAM started, i.e. the robot's spawn pose, so
      # the room extends from about (0,0) to (7,7) in map coordinates. Centring the view
      # on (3,3) keeps the whole room in frame as it is discovered.
      Focal Point: {X: 3.0, Y: 3.0, Z: 0}
      # Pitch is near vertical on purpose. The map is drawn at z=0 but the laser returns
      # are at the LiDAR's height (z=0.17 m), so with a tilted camera the returns are
      # projected outward and appear NOT to line up with the walls -- worst at the edges
      # of the view, fine near the centre. That is parallax, not a localisation error,
      # but it looks exactly like one. A top-down view removes the ambiguity.
      Pitch: 1.5500
      Yaw: 3.14
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 800
  Width: 1200
