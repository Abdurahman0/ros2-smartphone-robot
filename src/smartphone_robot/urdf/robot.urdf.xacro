<?xml version="1.0"?>
<!--
  Differential-drive mobile robot description.

  WHAT A URDF ACTUALLY IS
  =======================
  A URDF is not a 3D model. It is a KINEMATIC TREE: a list of rigid bodies (<link>)
  connected by <joint> elements that state exactly how each body may move relative to
  its parent. Three consumers read it, each taking a different part:

    * robot_state_publisher reads the joints and publishes the TF transform tree.
    * RViz reads the <visual> blocks to draw the robot.
    * Gazebo reads <collision> and <inertial> to simulate contact and physics.

  So the same file serves visualisation, physics and coordinate maths. On a real robot
  the <visual> and <inertial> parts stop mattering, but the joint geometry becomes
  critical: those numbers are what convert a laser hit into a position in the world.
  Measure them on the real hardware or SLAM will quietly be wrong.

  WHY XACRO
  =========
  Plain URDF has no variables, so every dimension would be repeated as a magic number
  and the two wheels would be copy-pasted. Xacro adds properties and macros and expands
  to ordinary URDF before anything else sees it.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="smartphone_robot">

  <xacro:include filename="inertial_macros.xacro"/>

  <!-- ==================== Dimensions =====================================
       One place to change the robot's shape. Everything below is derived from
       these, so the model stays self-consistent.
       Chosen to resemble a small indoor research platform (TurtleBot-sized), which
       keeps the simulation realistic and the Nav2 tuning later meaningful.
  -->
  <xacro:property name="base_length"  value="0.35"/>   <!-- x, forward  [m] -->
  <xacro:property name="base_width"   value="0.22"/>   <!-- y, left     [m] -->
  <xacro:property name="base_height"  value="0.10"/>   <!-- z, up       [m] -->
  <xacro:property name="base_mass"    value="5.0"/>    <!-- [kg] -->

  <xacro:property name="wheel_radius"     value="0.05"/>
  <xacro:property name="wheel_width"      value="0.04"/>
  <xacro:property name="wheel_mass"       value="0.5"/>
  <!-- Track width: distance between the two wheel contact points. This number is
       what converts left/right wheel speeds into rotation rate, so the differential
       drive plugin and any odometry must use exactly the same value. -->
  <xacro:property name="wheel_separation" value="0.26"/>
  <xacro:property name="wheel_x_offset"   value="-0.05"/>  <!-- wheels slightly aft -->

  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="caster_mass"   value="0.1"/>
  <xacro:property name="caster_x"      value="0.13"/>

  <xacro:property name="lidar_radius" value="0.035"/>
  <xacro:property name="lidar_height" value="0.04"/>
  <xacro:property name="lidar_mass"   value="0.15"/>

  <xacro:property name="PI" value="3.14159265359"/>

  <!-- ==================== Materials (RViz colours only) ================== -->
  <material name="chassis">  <color rgba="0.34 0.40 0.50 1.0"/></material>
  <material name="deck">     <color rgba="0.20 0.58 0.86 1.0"/></material>
  <material name="tyre">     <color rgba="0.08 0.08 0.09 1.0"/></material>
  <material name="hub">      <color rgba="0.62 0.64 0.68 1.0"/></material>
  <material name="grey">     <color rgba="0.45 0.47 0.52 1.0"/></material>
  <material name="sensor">   <color rgba="0.18 0.19 0.23 1.0"/></material>
  <material name="lens">     <color rgba="0.10 0.35 0.55 1.0"/></material>
  <material name="marker">   <color rgba="0.92 0.36 0.18 1.0"/></material>
  <material name="white">    <color rgba="0.88 0.89 0.92 1.0"/></material>

  <!-- ==================== base_footprint =================================
       The tree's root: a massless frame on the GROUND directly below the robot's
       centre, with no visual and no collision.

       Why it exists: Nav2 and SLAM reason about the robot as a point on a floor plan.
       base_footprint gives them a frame whose z is always 0, so "where is the robot
       on the map" needs no knowledge of chassis height or suspension travel.
       Convention across the whole ROS navigation stack.
  -->
  <link name="base_footprint"/>

  <!-- ==================== base_link (chassis) ============================ -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <!-- Lift base_link so the wheel axles (at base_link z=0) sit one wheel radius
         above the ground. -->
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <!-- Several visual elements on one link. URDF allows this, and it costs nothing:
         collision and inertia are unchanged, so physics and TF are identical.

         BUT RViz AND GAZEBO DISAGREE ABOUT MATERIALS HERE, and it is worth knowing why.
         Gazebo renders each <visual> with its own material, so the robot appears as
         designed: slate body, blue deck, orange bumper. RViz applies ONE material per
         LINK  - whichever the first <visual> declares  - so in RViz the whole chassis
         takes the 'chassis' colour and the deck and bumper are invisible. Verified by
         reordering the visuals: putting 'deck' first turns the entire body blue.

         So the visual order below is deliberate: 'chassis' first, because that is the
         colour RViz will use for the whole link. The rest is detail only Gazebo shows.
         Splitting the deck and bumper into their own links would make RViz colour them
         too, but it would add frames to the TF tree purely for decoration, which is not
         a trade worth making in a robot description. -->
    <visual name="chassis">
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="chassis"/>
    </visual>
    <visual name="deck">
      <origin xyz="-0.01 0 ${base_height + 0.008}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length*0.82} ${base_width*0.88} 0.016"/>
      </geometry>
      <material name="deck"/>
    </visual>
    <visual name="front_bumper">
      <origin xyz="${base_length/2 - 0.012} 0 ${base_height*0.42}" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 ${base_width*0.94} ${base_height*0.55}"/>
      </geometry>
      <material name="marker"/>
    </visual>
    <visual name="rear_panel">
      <origin xyz="${-base_length/2 + 0.010} 0 ${base_height*0.5}" rpy="0 0 0"/>
      <geometry>
        <box size="0.020 ${base_width*0.80} ${base_height*0.6}"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="${base_mass}"
                        x="${base_length}" y="${base_width}" z="${base_height}">
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- ==================== Drive wheels ===================================
       A macro, instantiated twice. 'reflect' is +1 for left, -1 for right.

       type="continuous" = a hinge with no limits, free to spin forever. That is what
       makes this a *drive* wheel rather than decoration: the differential drive
       controller in Gazebo looks for exactly these two joints by name and turns them.
       A "fixed" joint here would give a robot that cannot move.
  -->
  <xacro:macro name="drive_wheel" params="prefix reflect">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel_link"/>
      <origin xyz="${wheel_x_offset} ${reflect * wheel_separation/2} 0"
              rpy="${-PI/2} 0 0"/>
      <!-- Rotation axis expressed in the CHILD frame. After the -90 deg roll above,
           the cylinder's own z points sideways, so spinning about z rolls the wheel. -->
      <axis xyz="0 0 1"/>
    </joint>

    <link name="${prefix}_wheel_link">
      <visual name="tyre">
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="tyre"/>
      </visual>
      <!-- A hub that is visibly off-centre in rotation, so wheel spin is obvious in
           RViz and in the Gazebo GUI. Useful when checking that the differential drive
           plugin is actually turning the joints. -->
      <visual name="hub">
        <origin xyz="0 0 ${wheel_width/2 + 0.001}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius*0.45}" length="0.004"/>
        </geometry>
        <material name="hub"/>
      </visual>
      <visual name="spoke">
        <origin xyz="${wheel_radius*0.6} 0 ${wheel_width/2 + 0.002}" rpy="0 0 0"/>
        <geometry>
          <box size="${wheel_radius*0.55} 0.008 0.004"/>
        </geometry>
        <material name="marker"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:inertial_cylinder mass="${wheel_mass}"
                               radius="${wheel_radius}" length="${wheel_width}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>
  </xacro:macro>

  <xacro:drive_wheel prefix="left"  reflect="1"/>
  <xacro:drive_wheel prefix="right" reflect="-1"/>

  <!-- ==================== Caster =========================================
       Two driven wheels cannot stand up on their own, so a passive third contact
       point is needed. A frictionless sphere is the standard trick: it supports the
       chassis without resisting turns the way a fixed third wheel would.
  -->
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster_link"/>
    <origin xyz="${caster_x} 0 ${-(wheel_radius - caster_radius)}" rpy="0 0 0"/>
  </joint>

  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <xacro:inertial_sphere mass="${caster_mass}" radius="${caster_radius}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_sphere>
  </link>

  <!-- ==================== LiDAR ==========================================
       The frame name matters beyond bookkeeping: the LaserScan messages published
       later carry header.frame_id = "lidar_link", and TF2 uses THIS joint's origin to
       work out where each range reading actually is in the world. Get this offset
       wrong and SLAM builds a map that is subtly skewed.
  -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="0.06 0 ${base_height + lidar_height/2}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual name="lidar_body">
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="sensor"/>
    </visual>
    <!-- The orange band sits at the scan plane, which makes it easy to see at a glance
         how high the LiDAR actually measures and what it can therefore never see:
         anything below this line is invisible to a 2D laser. -->
    <visual name="scan_band">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius*1.06}" length="0.008"/>
      </geometry>
      <material name="marker"/>
    </visual>
    <visual name="lidar_cap">
      <origin xyz="0 0 ${lidar_height/2 + 0.004}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius*0.8}" length="0.008"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="${lidar_mass}"
                             radius="${lidar_radius}" length="${lidar_height}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <!-- ==================== Camera =========================================
       TWO frames, and the reason is a genuine trap.

       camera_link follows the ROS body convention: x forward, y left, z up.
       camera_optical_link follows the OPTICAL convention used by every vision
       library: z forward (into the scene), x right, y down.

       OpenCV, camera_info and image geometry all assume the optical convention. Point
       clouds and detections computed in camera_link instead of camera_optical_link
       come out rotated by 90 degrees  - a classic bug that looks like broken
       calibration. The fixed joint below is that conversion, done once, declaratively.
  -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${base_length/2} 0 ${base_height*0.75}" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual name="camera_housing">
      <geometry><box size="0.022 0.070 0.026"/></geometry>
      <material name="sensor"/>
    </visual>
    <visual name="camera_lens">
      <origin xyz="0.013 0 0" rpy="0 ${PI/2} 0"/>
      <geometry><cylinder radius="0.009" length="0.006"/></geometry>
      <material name="lens"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.06 0.02"/></geometry>
    </collision>
    <xacro:inertial_box mass="0.05" x="0.02" y="0.06" z="0.02">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>
  <link name="camera_optical_link"/>

  <!-- ==================== IMU ============================================
       Placed at the chassis centre. On real hardware an IMU mounted off-centre reads
       centripetal acceleration during turns that a centre-mounted one does not, so
       this offset is not cosmetic  - it belongs in the model.

       This frame is also where the SMARTPHONE's IMU data will be published, so the
       rest of the system treats phone measurements as ordinary robot sensor data.
  -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>

  <!-- Simulator plugins and sensors. Harmless outside Gazebo: RViz and
       robot_state_publisher ignore <gazebo> elements entirely. -->
  <xacro:include filename="gazebo.xacro"/>

</robot>
