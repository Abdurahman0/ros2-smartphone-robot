<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>smartphone_robot</name>
  <version>0.0.0</version>
  <description>Smartphone-based autonomous robotics system: streams real phone sensors
  (camera, IMU, GPS) into ROS 2, processes them with OpenCV, and drives a simulated
  mobile robot in Gazebo using SLAM and Navigation2.</description>
  <maintainer email="cognilabsco@gmail.com">Abdurahmon</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>smartphone_robot_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
