      </link>
    </model>
    <model name="planter">
      <static>true</static>
      <pose>3.2 3.2 0.22 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.28</radius><length>0.44</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.28</radius><length>0.44</length></cylinder></geometry>
          <material>
            <ambient>0.143 0.264 0.154 1.0</ambient>
            <diffuse>0.260 0.480 0.280 1.0</diffuse>
            <specular>0.15 0.15 0.15 1.0</specular>
            <pbr><metal>
              <metalness>0.0</metalness>
              <roughness>0.9</roughness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- A fixed overview camera for documentation.
         Gazebo's GUI cannot run on a virtual framebuffer (its Ogre2 renderer crashes
         under software OpenGL), but the Sensors system renders on the real GPU even
         with the simulator headless. So a static camera sensor is how this project
         produces a picture of the world without needing a physical display.
         2 Hz and only enabled on demand, so it costs almost nothing. -->
    <model name="overview_camera">
      <static>true</static>
      <pose>-7.0 -7.0 6.8 0 0.60 0.785</pose>
      <link name="link">
        <sensor name="overview" type="camera">
          <topic>overview/image</topic>
          <update_rate>2</update_rate>
          <always_on>true</always_on>
          <camera>
            <horizontal_fov>1.25</horizontal_fov>
            <image>
              <width>1280</width>
              <height>800</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.1</near><far>60.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- Close-up documentation camera aimed at the spawn point, for the same reason as
         overview_camera: it renders on the GPU even when Gazebo runs headless. 1 Hz. -->
    <model name="robot_closeup_camera">
      <static>true</static>
      <pose>-2.00 -3.90 0.55 0 0.29 2.408</pose>
      <link name="link">
        <sensor name="closeup" type="camera">
          <topic>closeup/image</topic>
          <update_rate>1</update_rate>
          <always_on>true</always_on>
          <camera>
            <horizontal_fov>0.72</horizontal_fov>
            <image><width>1100</width><height>750</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>40.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- Bright red target post for the vision demo (follow_sim.launch.py).
         Placed straight ahead of the robot's spawn pose with clear line of sight, and a
         pure saturated red that nothing else in the world shares  - the grey pillars,
         brown crates, green planter and blue trim are all far from red in hue, so the
         colour detector cannot confuse them for it. -->
    <model name="target_post">
      <static>true</static>
      <pose>1.2 -3.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.16</radius><length>0.7</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.16</radius><length>0.7</length></cylinder></geometry>
          <material>
            <ambient>0.55 0.02 0.02 1</ambient>
            <diffuse>0.95 0.05 0.05 1</diffuse>
            <specular>0.3 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
