<?xml version="1.0" ?>
<!--
  Indoor world for SLAM and navigation testing.

  A world file is SDF, not URDF. SDF describes a whole scene (lights, physics, several
  models); URDF describes one articulated robot. Gazebo converts the robot's URDF into
  SDF when it is spawned.

  The plugin list below is what makes the simulator do anything, and each is required
  for a specific reason:
    Physics           steps the dynamics. Without it nothing moves.
    UserCommands      lets other processes spawn and delete models, which is how the
                      robot gets in here at all.
    SceneBroadcaster  streams the scene to the GUI.
    Sensors           renders the camera and GPU LiDAR. Without it those sensors exist
                      but publish nothing, which is a confusing silent failure.
    Imu               ticks the IMU sensor, same story.
    Contact           reports collisions.

  Layout: an 8 x 8 m room with an L-shaped partition, pillars, crates and a
  table. The partition matters: it forces the robot out of line of sight of where it
  started, so returning later is a genuine LOOP CLOSURE rather than a trivial
  re-observation. The varied shapes matter too: a room of identical flat walls gives scan
  matching nothing to lock onto, and SLAM slides along them.

  Note the objects at LiDAR height (0.17 m): skirting boards and the bands on the pillars
  sit exactly in the scan plane, so what the robot sees is visually obvious in the GUI.
-->
<sdf version="1.10">
  <world name="indoor">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.62 0.63 0.66 1</ambient>
      <background>0.52 0.62 0.74 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Key light plus two fills. One light casts hard shadows that hide obstacles from
         the camera; the fills keep the scene readable without flattening it. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.85 0.84 0.80 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.45 0.35 -0.82</direction>
    </light>
    <light type="point" name="lamp_a">
      <pose>-2 -2 2.6 0 0 0</pose>
      <diffuse>0.45 0.45 0.50 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>12</range><linear>0.12</linear><quadratic>0.01</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type="point" name="lamp_b">
      <pose>2.5 2.5 2.6 0 0 0</pose>
      <diffuse>0.40 0.42 0.48 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>12</range><linear>0.12</linear><quadratic>0.01</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.253 0.242 0.226 1.0</ambient>
            <diffuse>0.460 0.440 0.410 1.0</diffuse>
            <specular>0.08 0.08 0.08 1.0</specular>
            <pbr><metal>
              <metalness>0.0</metalness>
              <roughness>0.95</roughness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>4.075 0 0.6599999999999999 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 8.3 1.08</size></box></geometry>
        </collision>
